# ReviewLens Environment Variables
# Copy this file to .env and insert your real Gemini API key

# Google Gemini API Key (get a free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Name (e.g., gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
LLM_MODEL=gemini-1.5-flash

# Review Processing Batch Size (default 5 as per assessment requirement 5)
BATCH_SIZE=5

# Maximum API retries with exponential backoff
MAX_RETRIES=2

# Server Port and Host
PORT=8000
HOST=127.0.0.1
